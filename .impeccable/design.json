  "components": [
    {
      "name": "Product Label",
      "kind": "card",
      "refersTo": "label-stock",
      "description": "Thermal label on carton: photo well, name, routing block, badges, manifest.",
      "html": "<article class=\"ds-label\"><div class=\"ds-well\"></div><p class=\"ds-name\"><b>Kings Caravan Floor Mat</b> <span>\u00b7 Reversible \u00b7 5m x 2.4m</span></p><div class=\"ds-route\"><span class=\"ds-price\">$76.95</span><span class=\"ds-cmp\"><small>Alone</small><s>$169.00</s></span></div><div class=\"ds-body\"><p class=\"ds-how\">Cheapest inside a bundle</p><span class=\"ds-badge\">54% less than alone</span></div></article>",
      "css": ".ds-label{display:flex;flex-direction:column;width:16rem;border:2px solid var(--border);background:var(--card);color:var(--card-foreground);font-family:Barlow,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-well{height:6rem;background:#fff;border-bottom:2px solid var(--border)}.ds-name{margin:0;padding:10px 12px 8px;font-size:.9375rem;line-height:1.375}.ds-name b{font-weight:600}.ds-name span{color:var(--muted-foreground)}.ds-route{display:grid;grid-template-columns:auto 1fr;border-top:2px solid var(--border)}.ds-price{background:var(--primary);color:var(--primary-foreground);padding:4px 12px;font:700 2rem/1.25 'Barlow Condensed',Barlow,sans-serif}.ds-cmp{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;padding:0 12px;line-height:1.25}.ds-cmp small{font:700 .8125rem 'Barlow Condensed',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-foreground)}.ds-cmp s{font-weight:600}.ds-body{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:8px 12px 12px}.ds-how{margin:0;font-size:.8125rem;color:var(--muted-foreground)}.ds-badge{background:var(--good);color:var(--background);padding:2px 6px;font:700 .8125rem/1.25 'Barlow Condensed',sans-serif;letter-spacing:.06em;text-transform:uppercase}"
    },
    {
      "name": "Consignment Manifest",
      "kind": "custom",
      "refersTo": "manifest-line-marked",
      "description": "The winning bundle counted out piece by piece, this product's line marked.",
      "html": "<a class=\"ds-manifest\" href=\"#\"><p><small>Consignment</small><b>SC-CO-CMAT5X2.4-CLEARTOPBAG</b></p><ul><li class=\"on\"><span>Kings Caravan Floor Mat</span><b>PCS 1/2</b></li><li><span>Kings Clear Top Canvas Bag</span><b>PCS 2/2</b></li></ul></a>",
      "css": ".ds-manifest{display:block;width:15rem;border:2px solid var(--border);color:var(--card-foreground);background:var(--card);text-decoration:none;font-family:Barlow,sans-serif;font-variant-numeric:tabular-nums}.ds-manifest:hover{background:var(--muted)}.ds-manifest:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-manifest p{margin:0;padding:4px 8px 2px;border-bottom:1px solid var(--rule);line-height:1.25}.ds-manifest small{display:block;font:700 .6875rem 'Barlow Condensed',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-foreground)}.ds-manifest p b{display:block;font:700 .8125rem 'Barlow Condensed',sans-serif;letter-spacing:.04em;word-break:break-all}.ds-manifest ul{list-style:none;margin:0;padding:0;font-size:.8125rem;line-height:1.375}.ds-manifest li{display:flex;justify-content:space-between;gap:8px;padding:4px 8px;border-top:1px solid var(--rule)}.ds-manifest li:first-child{border-top:0}.ds-manifest li.on{background:var(--good-bg);font-weight:600}.ds-manifest li b{flex-shrink:0;font:700 .8125rem 'Barlow Condensed',sans-serif;letter-spacing:.04em;white-space:nowrap}"
    },
    {
      "name": "Tone Badges",
      "kind": "chip",
      "refersTo": "tone-badge-good",
      "description": "Three signal tones only: saving, take note, dearer.",
      "html": "<div class=\"ds-tones\"><span class=\"ds-tone ds-good\">54% less than alone</span><span class=\"ds-tone ds-warn\" title=\"Usual price from day 14\">New low</span><span class=\"ds-tone ds-bad\">$40 more than parts</span></div>",
      "css": ".ds-tones{display:flex;flex-wrap:wrap;gap:4px}.ds-tone{display:inline-flex;align-items:center;padding:2px 6px;font:700 .8125rem/1.25 'Barlow Condensed',Barlow,sans-serif;letter-spacing:.06em;text-transform:uppercase}.ds-good{background:var(--good);color:var(--background)}.ds-warn{background:var(--hivis);color:var(--hivis-ink);cursor:help}.ds-bad{background:var(--bad);color:var(--background)}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Ruled rows with result counts; pressed reverses; empty ones disabled with a reason.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\"><span>In stock</span><span>536</span></button><button class=\"ds-chip\" aria-pressed=\"false\"><span>Cheaper in a bundle</span><span>282</span></button><button class=\"ds-chip\" disabled><span>At all-time low</span><span>0</span></button><p class=\"ds-why\">Needs price changes; history is still building</p></div>",
      "css": ".ds-chips{display:flex;flex-direction:column;gap:6px;width:15rem;font-variant-numeric:tabular-nums}.ds-chip{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:36px;padding:0 10px;border:2px solid var(--border);border-radius:0;background:var(--card);color:var(--card-foreground);font:600 .875rem Barlow,sans-serif;text-align:left;cursor:pointer;transition:background-color .15s,color .15s}.ds-chip span:last-child{font-weight:500}.ds-chip:hover{background:var(--muted)}.ds-chip:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-chip[aria-pressed=true]{background:var(--primary);color:var(--primary-foreground)}.ds-chip:disabled{cursor:not-allowed;border-style:dashed;background:color-mix(in oklab,var(--card) 60%,transparent);color:var(--muted-foreground)}.ds-why{margin:-4px 0 4px;font:400 .75rem Barlow,sans-serif;color:var(--page-muted)}"
    },
    {
      "name": "Black Bar and Hi-Vis Band",
      "kind": "nav",
      "refersTo": "black-bar",
      "description": "Top bar with mark and condensed tabs; the handling band of status under it.",
      "html": "<header class=\"ds-bar\"><a class=\"ds-mark\" href=\"#\"><svg viewBox=\"0 0 32 32\" width=\"28\" height=\"28\" aria-hidden=\"true\"><path d=\"M2 2h28v20l-8 8H2z\" fill=\"#f4c300\"/><path d=\"M30 22h-8v8\" fill=\"none\" stroke=\"#13110f\" stroke-width=\"2\"/><path d=\"M7 10l6 6 4-4 7 7\" fill=\"none\" stroke=\"#13110f\" stroke-width=\"3\"/></svg>Kings Deal Tracker</a><nav><a href=\"#\" aria-current=\"page\">Products</a><a href=\"#\">Bundles</a><a href=\"#\">List <span>3</span></a></nav></header><ul class=\"ds-band\"><li>Unofficial price tracker</li><li>Prices pulled 17 Nov, 9:11 pm</li><li>Tracking 2 days \u00b7 usual prices from day 14</li></ul>",
      "css": ".ds-bar{display:flex;align-items:center;gap:24px;padding:10px 24px;background:var(--bar);color:var(--bar-ink)}.ds-mark{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font:800 1.25rem 'Barlow Condensed',sans-serif;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}.ds-bar nav{display:flex;gap:4px}.ds-bar nav a{display:flex;align-items:center;gap:6px;min-height:40px;padding:0 16px;color:var(--bar-muted);text-decoration:none;font:700 1rem 'Barlow Condensed',sans-serif;letter-spacing:.06em;text-transform:uppercase}.ds-bar nav a:hover{color:var(--bar-ink)}.ds-bar nav a:focus-visible{outline:2px solid var(--hivis);outline-offset:2px}.ds-bar nav a[aria-current=page]{background:var(--bar-ink);color:var(--bar)}.ds-bar nav a span{background:var(--hivis);color:var(--hivis-ink);padding:0 6px;font:700 .75rem/1.25rem Barlow,sans-serif}.ds-band{display:flex;flex-wrap:wrap;gap:2px 24px;margin:0;padding:6px 24px;list-style:none;background:var(--hivis);color:var(--hivis-ink);font:700 .875rem 'Barlow Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Square ruled field with inset icon; autocomplete highlights in hi-vis.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input placeholder=\"Search products, categories or SKU\" aria-label=\"Search\"></label>",
      "css": ".ds-search{position:relative;display:block;width:20rem}.ds-search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted-foreground)}.ds-search input{box-sizing:border-box;width:100%;height:40px;padding:0 36px;border:2px solid var(--input);border-radius:0;background:var(--card);color:var(--card-foreground);font:400 .9375rem Barlow,sans-serif;outline:none}.ds-search input::placeholder{color:var(--muted-foreground)}.ds-search input:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
